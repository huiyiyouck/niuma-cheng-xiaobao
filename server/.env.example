# ── v0.5 必需 ───────────────────────────
DATABASE_URL=postgresql://news:news@localhost:5432/news
# 数据库超时四项（默认即推荐值，见 docs/progress/ad-hoc/2026-07-30-spike-db-timeout-config.md §3.1）
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=60000
DB_LOCK_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=10000
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── 服务端口 ────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── Admin ───────────────────────────────
ADMIN_TOKEN=your-admin-token
ADMIN_ALLOWED_IPS=127.0.0.1

# ── Worker 并发 ──────────────────────────
FETCH_CONCURRENCY=2
PROCESS_CONCURRENCY=1

# ── v0.6 L0/L1（新增）────────────────────
# LLM 模型（可选，不设则 fallback 到 OPENAI_MODEL）
L0_LLM_MODEL=gpt-4o-mini
L1_LLM_MODEL=gpt-4o-mini
LLM_L0_MAX_RETRIES=3
LLM_L1_MAX_RETRIES=3
LLM_TIMEOUT_MS=60000

# L1 并发（独立 sem，避免阻塞 v0.5 process_raw_item）
L1_CONCURRENCY=3

# ── X/Twitter ────────────────────────────
X_BEARER_TOKEN=
X_PROXY_URL=

# ── 金十 MCP ────────────────────────────
JIN10_MCP_URL=
JIN10_MCP_TOKEN=

# ── 调度策略 ─────────────────────────────
SCHEDULER_SCAN_SECONDS=5
DEFAULT_FETCH_EVERY_SECONDS=600
DEFAULT_MAX_ITEMS_PER_RUN=20
DEFAULT_FAIL_ALERT_THRESHOLD=5
DEFAULT_ZERO_NEW_HOURS=24
TASK_STALE_SECONDS=600

# ── v0.6.1 AI 数据库契约集成 ────────────────
# database=数据库契约异步模式（ai_worker 轮询处理）/ http=HTTP 同步模式（灰度回退）
AI_INTEGRATION_MODE=database
# AI 卡死回收超时阈值（毫秒，默认 10 分钟）
AI_STALE_TIMEOUT_MS=600000
# AI 最大重试次数（默认 3）
AI_MAX_RETRIES=3
