# v0.6 测试数据库配置
# 独立于生产库，避免 cleanTestData() 误删生产数据
# （教训：2026-06-08 测试直连生产 DB 事故）
DATABASE_URL=postgresql://news:news@localhost:5433/news_test

# 测试用 LLM（可选，非集成测试不需要）
OPENAI_API_KEY=test-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 测试 token
ADMIN_TOKEN=test-token

# 测试代理（关闭）
HTTP_PROXY=
HTTPS_PROXY=
X_PROXY_URL=
