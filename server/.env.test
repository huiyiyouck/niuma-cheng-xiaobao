# v0.6 测试数据库配置
# 独立于生产库，避免 cleanTestData() 误删生产数据
# （教训：2026-06-08 测试直连生产 DB 事故）
# （教训：2026-06-14 :8001 测试后端运行实例连 5432/news_test，vitest 曾误连同库，
#   cleanTestData 清空了 :8001 正在用的数据。本机仅一个 PG 实例(5432)、无 5433，
#   故改用独立库名 news_vitest，与 :8001 的 news_test 物理隔离，互不影响。）
DATABASE_URL=postgresql://news:news@localhost:5432/news_vitest

# 测试用 LLM（可选，非集成测试不需要）
OPENAI_API_KEY=test-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 测试 token
ADMIN_TOKEN=test-token

# 测试代理（关闭）
HTTP_PROXY=
HTTPS_PROXY=
X_PROXY_URL=
